{
  "rules": {
    ".read": false,
    ".write": false,
    "ghostLaptop": {
      "leaderboard": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "newData.hasChildren(['initials', 'score'])",
          "initials": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z]{2,4}$/)"
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 70"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
